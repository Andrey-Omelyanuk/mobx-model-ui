{
    "compilerOptions": {
        "rootDir": "src",
        "module": "es2022",
        "target": "es2022",
        "strict": true,
        "moduleResolution": "bundler",
        "emitDecoratorMetadata": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": true,
        "skipLibCheck": true,
        "declaration": false,
        "lib": ["dom", "es2022"],
    },
    "exclude": ["node_modules", "e2e", "**/*.spec.ts", "src/test.utils.ts"],
}
