{
  "name"        : "mobx-model-ui",
  "version"     : "0.3.3",
  "description" : "Data models and UI interactions based on MobX",
  "keywords": [
    "mobx", "model", "ui"
  ],
  "license"     : "MIT",
  "author"      : "Andrey Omelyanuk",
  "repository"  : {
    "type"  : "git",
    "url"   : "git@github.com:Andrey-Omelyanuk/mobx-model-ui.git"
  },
  "homepage": "https://github.com/Andrey-Omelyanuk/mobx-model-ui#readme",
  "bugs": {
    "url": "https://github.com/Andrey-Omelyanuk/mobx-model-ui/issues"
  },
  "publishConfig": {
    "registry"  : "https://registry.npmjs.org/" 
  },
  "main"        : "dist/mobx-model-ui.js",
  "module"      : "dist/mobx-model-ui.es2015.js",
  "typings"     : "dist/mobx-model-ui.d.ts",
  "files": [
    "dist",
    "src",
    "AGENTS.md",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "mobx"      : "~6.7.0"
  },
  "scripts": {
    "build" : "rollup -c --bundleConfigAsCjs",
    "dev"   : "jest --selectProjects unit --watchAll",
    "test"  : "jest --selectProjects unit --coverage",
    "e2e"   : "jest --selectProjects e2e",
    "lint"  : "eslint 'src/**/*.ts'",
    "lint-fix": "eslint 'src/**/*.ts' --fix"
  },
  "devDependencies": {
    "typescript"                  : "^6.0.3",
    "eslint"                      : "^9.39.0",
    "typescript-eslint"           : "^8.54.0",
    "@typescript-eslint/parser"   : "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "jest"                        : "^30.4.2",
    "jest-environment-jsdom"      : "^30.4.1", 
    "ts-jest"                     : "^29.4.11", 
    "@types/jest"                 : "^30.0.0", 

    "rollup"                    : "^4.61.1",
    "rollup-plugin-typescript2" : "^0.37.0",
    "rollup-plugin-dts"         : "^6.4.1" 
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "jsdom",
        "testMatch": ["<rootDir>/src/**/*.spec.ts"],
        "transform": {
          "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.spec.json" }]
        }
      },
      {
        "displayName": "e2e",
        "testEnvironment": "jsdom",
        "testMatch": ["<rootDir>/e2e/**/*.ts"],
        "transform": {
          "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.e2e.json" }]
        }
      }
    ],
    "coverageDirectory": "node_modules/.cache/coverage",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleDirectories": [
      "node_modules"
    ],
    "modulePaths": [
      "."
    ]
  }
}